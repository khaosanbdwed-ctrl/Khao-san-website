# Copy to .env.local for local development, and set the same variables in the
# hosting platform for deploys. .env.local is gitignored, so a deploy host has
# NONE of these unless you add them there explicitly - that is what causes
# `Error: supabaseUrl is required.` while prerendering /menu during a build.
#
# On Vercel: Project -> Settings -> Environment Variables, and tick
# Production, Preview and Development. Redeploy after adding them.
#
# Values are in the project's Supabase dashboard (Settings -> API) and in the
# team password manager. Never commit real values.

# --- Supabase: public, exposed to the browser ---
# Used by the menu page and every public read. RLS grants anon SELECT only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>

# --- Supabase: server only, NEVER prefix with NEXT_PUBLIC_ ---
# Bypasses RLS. Used by the admin menu and upload API routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Admin panel sign-in ---
ADMIN_USERNAME=<username>
ADMIN_PASSWORD=<password>
