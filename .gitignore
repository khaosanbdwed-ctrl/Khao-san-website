# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template with no real values must be committed - it is how a
# deploy host knows which variables to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw brand masters: ~39MB of source video and social exports. Kept locally,
# never referenced at runtime (only the derived files under public/assets are),
# and git history is permanent - so they stay out of a public repo.
_masters/

# Generated: the graphify knowledge graph output, rebuilt by `graphify .`
graphify-out/

# Vendored agent tooling, reinstallable with `npx impeccable install`
.claude/skills/
.agents/
.claude/settings.local.json
